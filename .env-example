# Postgres (local / compose; en RDS usa la URL que te dé Terraform)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# JWT
JWT_SECRET=

# Redis (en Docker producción: redis://redis:6379)
REDIS_URL=

# Backend
PORT=
# Orígenes CORS separados por coma (p. ej. http://localhost:5173,http://127.0.0.1:5500)
CORS_ORIGIN=
VERIFICATION_CODE_TTL=
VERIFICATION_RATE_LIMIT_SECONDS=

# Google Maps (API del backend, p. ej. geocoding)
GOOGLE_MAPS_API_KEY=

# Brevo (Sendinblue)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# AWS S3 (firmas / adjuntos)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_SIGNED_URL_TTL=

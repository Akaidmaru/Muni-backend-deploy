generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int               @id @default(autoincrement())
  email     String            @unique
  phone     String?           @unique
  name      String?
  password  String
  createdAt DateTime          @default(now())
  role      UserRole          @default(PATIENT)
  occupationId Int?
  occupation Occupation?      @relation(fields: [occupationId], references: [id])
  trucks    TruckAssignment[]
  isVerified Boolean          @default(false)
}

model Truck {
  id     Int               @id @default(autoincrement())
  plate  String            @unique
  model  String
  routes Route[]
  users  TruckAssignment[]
}

model RoutePoint {
  id        Int      @id @default(autoincrement())
  routeId   Int
  latitude  Float
  longitude Float
  order     Int
  route     Route    @relation(fields: [routeId], references: [id])
}
model TruckAssignment {
  userId  Int
  truckId Int
  truck   Truck @relation(fields: [truckId], references: [id])
  user    User  @relation(fields: [userId], references: [id])

  @@id([userId, truckId])
}

model Route {
  id      Int    @id @default(autoincrement())
  origin  String
  destination String
  truckId Int
  truck   Truck  @relation(fields: [truckId], references: [id])
  points  RoutePoint[]
}

model Occupation {
  id   Int    @id @default(autoincrement())
  name String
  users User[]
}

enum UserRole {
  PATIENT
  EMPLOYEE
  DRIVER
  ADMIN
}
generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      Int                      @id @default(autoincrement())
  email                   String                   @unique
  rut                     String                   @unique
  phone                   String?                  @unique
  name                    String?
  password                String
  createdAt               DateTime                 @default(now())
  role                    UserRole                 @default(EMPLOYEE)
  managedById             Int?
  managedByUser           User?                    @relation("UserManagedBy", fields: [managedById], references: [id])
  managedUsers            User[]                   @relation("UserManagedBy")
  managedEmployees        Employee[]
  managedTrucks           Truck[]
  managedDestinations     Destination[]
  occupationId            Int?
  occupation              Occupation?              @relation(fields: [occupationId], references: [id])
  trucks                  TruckAssignment[]
  dailyMaintenanceRecords DailyMaintenanceRecord[]
  problemReports          ProblemReport[]
  problemReportTimelines  ProblemReportTimeline[]
  plateChangeLogs         TruckPlateChangeLog[]
  serviceRequests         ServiceRequest[]
  isVerified              Boolean                  @default(false)
  tripHistoriesAsDriver   TripHistory[]
}

model Employee {
  id            Int           @id @default(autoincrement())
  name          String
  active        Boolean       @default(true)
  managedById   Int?
  managedBy     User?         @relation(fields: [managedById], references: [id])
  createdAt     DateTime      @default(now())
  tripHistories TripHistory[]

  @@index([name])
}

model Truck {
  id                         Int                        @id @default(autoincrement())
  plate                      String                     @unique
  brand                      String?
  model                      String
  year                       Int?
  seatCount                  Int?
  mileage                    Float                      @default(0)
  status                     TruckStatus                @default(ACTIVE)
  managedById                Int?
  managedBy                  User?                      @relation(fields: [managedById], references: [id])
  technicalReviewExpiresAt   DateTime?                  @db.Date
  circulationPermitExpiresAt DateTime?                  @db.Date
  insuranceExpiresAt         DateTime?                  @db.Date
  emissionsExpiresAt         DateTime?                  @db.Date
  users                      TruckAssignment[]
  documents                  TruckDocument[]
  tripHistories              TripHistory[]
  dailyMaintenanceRecords    DailyMaintenanceRecord[]
  monthlyMaintenanceRecords  MonthlyMaintenanceRecord[]
  plateChangeLogs            TruckPlateChangeLog[]
}

model TruckDocument {
  id           Int               @id @default(autoincrement())
  truckId      Int
  documentType TruckDocumentType
  bucketKey    String
  uploadedAt   DateTime          @default(now())

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@unique([truckId, documentType])
  @@index([truckId])
  @@index([documentType])
}

model Destination {
  id            Int           @id @default(autoincrement())
  name          String
  active        Boolean       @default(true)
  managedById   Int?
  managedBy     User?         @relation(fields: [managedById], references: [id])
  createdAt     DateTime      @default(now())
  tripHistories TripHistory[]

  @@unique([name, managedById])
}

model TripHistory {
  id            Int                @id @default(autoincrement())
  date          DateTime
  startTime     String
  endTime       String?
  status        TripHistoryStatus  @default(DRIVER_FILLING)
  startKm       Float
  endKm         Float?
  signatureKey  String?            @map("signature_key")
  truckId       Int
  destinationId Int
  employeeId    Int
  driverId      Int?
  truck         Truck              @relation(fields: [truckId], references: [id])
  destination   Destination        @relation(fields: [destinationId], references: [id])
  employee      Employee           @relation(fields: [employeeId], references: [id])
  driver        User?              @relation(fields: [driverId], references: [id])
  createdAt     DateTime           @default(now())
  points        TripHistoryPoint[]

  @@index([date])
  @@index([truckId])
  @@index([destinationId])
  @@index([employeeId])
  @@index([driverId])
  @@index([status])
}

model TripHistoryPoint {
  id            Int         @id @default(autoincrement())
  tripHistoryId Int
  latitude      Float
  longitude     Float
  capturedAt    DateTime    @default(now())
  tripHistory   TripHistory @relation(fields: [tripHistoryId], references: [id], onDelete: Cascade)

  @@index([tripHistoryId])
  @@index([tripHistoryId, id])
}

model TruckAssignment {
  userId  Int
  truckId Int
  truck   Truck @relation(fields: [truckId], references: [id])
  user    User  @relation(fields: [userId], references: [id])

  @@id([userId, truckId])
}

model TruckPlateChangeLog {
  id              Int               @id @default(autoincrement())
  truckId         Int
  changedByUserId Int
  reason          PlateChangeReason
  observations    String
  previousStatus  TruckStatus
  newStatus       TruckStatus
  createdAt       DateTime          @default(now())

  truck     Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)
  changedBy User  @relation(fields: [changedByUserId], references: [id], onDelete: Cascade)

  @@index([truckId])
  @@index([changedByUserId])
  @@index([createdAt])
}

model Occupation {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]
}

model DailyMaintenanceRecord {
  id               Int                          @id @default(autoincrement())
  truckId          Int
  driverId         Int
  inspectionDate   DateTime                     @db.Date
  inspectionTime   String
  municipalLicense String
  currentMileage   Float
  status           DailyMaintenanceRecordStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  truck                 Truck                  @relation(fields: [truckId], references: [id], onDelete: Cascade)
  driver                User                   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  dailyMaintenanceItems DailyMaintenanceItem[]

  // Índice compuesto: una vez por vehículo/día
  @@unique([truckId, inspectionDate])
  @@index([truckId])
  @@index([driverId])
  @@index([inspectionDate])
  @@map("DailyMaintenanceRecord")
}

model DailyMaintenanceItem {
  id       Int     @id @default(autoincrement())
  recordId Int
  itemCode String // "estacionamiento", "frenoMano", etc.
  itemName String
  category String // "systemLights", "systemBrakes", "systemTires", etc.
  exists   String // "Si", "No"
  status   String // "Bueno", "Regular", "Malo"
  notes    String?

  record DailyMaintenanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, itemCode])
  @@index([recordId])
  @@map("DailyMaintenanceItem")
}

model MonthlyMaintenanceRecord {
  id        Int                            @id @default(autoincrement())
  truckId   Int
  monthKey  String // Formato YYYY-MM
  status    MonthlyMaintenanceRecordStatus @default(PENDING)
  createdAt DateTime                       @default(now())
  updatedAt DateTime                       @updatedAt

  truck                   Truck                    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  monthlyMaintenanceItems MonthlyMaintenanceItem[]

  @@unique([truckId, monthKey])
  @@index([truckId])
  @@index([monthKey])
  @@map("MonthlyMaintenanceRecord")
}

model MonthlyMaintenanceItem {
  id        Int     @id @default(autoincrement())
  recordId  Int
  weekIndex Int // 1..5
  itemCode  String
  itemName  String
  category  String
  status    String
  notes     String?

  record MonthlyMaintenanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, weekIndex, itemCode])
  @@index([recordId])
  @@index([weekIndex])
  @@map("MonthlyMaintenanceItem")
}

model ProblemReport {
  id            Int                     @id @default(autoincrement())
  title         String
  description   String
  screenshotKey String?                 @map("screenshot_key")
  status        ProblemReportStatus     @default(OPEN)
  reporterId    Int
  reporter      User                    @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  timeline      ProblemReportTimeline[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
}

model ProblemReportTimeline {
  id             Int                    @id @default(autoincrement())
  reportId       Int
  actorId        Int
  eventType      ProblemReportEventType
  previousStatus ProblemReportStatus
  newStatus      ProblemReportStatus
  note           String?
  createdAt      DateTime               @default(now())

  report ProblemReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor  User          @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([actorId])
  @@index([createdAt])
}

model ServiceRequest {
  id             Int      @id @default(autoincrement())
  requestType    String
  driverAction   String?
  personName     String?
  plate          String?
  reason         String?
  attachmentKey  String?  @map("attachment_key")
  status         String   @default("PENDING")
  requesterId    Int
  requester      User     @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([requesterId])
  @@index([status])
  @@index([createdAt])
}

enum UserRole {
  PENDING_APPROVAL
  EMPLOYEE
  DRIVER
  ADMIN
  DIRECTION
}

enum TruckStatus {
  ACTIVE
  INACTIVE
}

enum TruckDocumentType {
  TECHNICAL_REVIEW
  CIRCULATION_PERMIT
  INSURANCE
  EMISSIONS
}

enum PlateChangeReason {
  LOGISTICA
  AVERIA
}

enum TripHistoryStatus {
  DRIVER_FILLING
  EMPLOYEE_SIGNED
  COMPLETED
}

enum ProblemReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum ProblemReportEventType {
  CREATED
  STATUS_CHANGED
  NOTE_ADDED
  NOTE_AND_STATUS_CHANGED
}

enum MonthlyMaintenanceRecordStatus {
  PENDING
  REVIEWED
}

enum DailyMaintenanceRecordStatus {
  PENDING
  REVIEWED
}

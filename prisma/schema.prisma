generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      Int               @id @default(autoincrement())
  email                   String            @unique
  phone                   String?           @unique
  name                    String?
  password                String
  createdAt               DateTime          @default(now())
  role                    UserRole          @default(EMPLOYEE)
  occupationId            Int?
  occupation              Occupation?      @relation(fields: [occupationId], references: [id])
  trucks                  TruckAssignment[]
  tripHistories           TripHistory[]
  vehicleMaintenanceRecords VehicleMaintenanceRecord[]
  isVerified              Boolean          @default(false)
}

model Truck {
  id                      Int               @id @default(autoincrement())
  plate                   String            @unique
  model                   String
  mileage                 Float            @default(0)
  routes                  Route[]
  users                   TruckAssignment[]
  tripHistories           TripHistory[]
  vehicleMaintenanceRecords VehicleMaintenanceRecord[]
}

model Destination {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  tripHistories TripHistory[]
  patients  Patient[]
}

model Patient {
  id            Int         @id @default(autoincrement())
  name          String
  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  tripHistories TripHistory[]

  @@index([destinationId])
  @@unique([destinationId, name])
}

model TripHistory {
  id            Int         @id @default(autoincrement())
  date          DateTime
  startTime     String
  endTime       String?
  status        TripHistoryStatus @default(DRIVER_FILLING)
  startKm       Float
  endKm         Float?
  signatureKey  String?     @map("signature_key")
  truckId       Int
  destinationId Int
  employeeId    Int
  patientId     Int?
  truck         Truck       @relation(fields: [truckId], references: [id])
  destination   Destination @relation(fields: [destinationId], references: [id])
  employee      User        @relation(fields: [employeeId], references: [id])
  patient       Patient?    @relation(fields: [patientId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([date])
  @@index([truckId])
  @@index([destinationId])
  @@index([employeeId])
  @@index([patientId])
  @@index([status])
}

model RoutePoint {
  id        Int      @id @default(autoincrement())
  routeId   Int
  latitude  Float
  longitude Float
  order     Int
  route     Route    @relation(fields: [routeId], references: [id])
}
model TruckAssignment {
  userId  Int
  truckId Int
  truck   Truck @relation(fields: [truckId], references: [id])
  user    User  @relation(fields: [userId], references: [id])

  @@id([userId, truckId])
}

model Route {
  id      Int    @id @default(autoincrement())
  origin  String
  destination String
  truckId Int
  truck   Truck  @relation(fields: [truckId], references: [id])
  points  RoutePoint[]
}

model Occupation {
  id   Int    @id @default(autoincrement())
  name String
  users User[]
}

model VehicleMaintenanceRecord {
  id                        Int     @id @default(autoincrement())
  truckId                   Int
  driverId                  Int
  inspectionDate            DateTime @db.Date
  inspectionTime            String
  municipalLicense          String
  currentMileage            Float
  
  // Documentos/Anexos
  technicalReviewStatus     String   // "Bueno", "Regular", "Malo"
  circulationPermitStatus   String   // "Bueno", "Regular", "Malo"
  insuranceStatus           String   // "Bueno", "Regular", "Malo"
  
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  
  // Relaciones
  truck                     Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  driver                    User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  maintenanceItems          MaintenanceItem[]
  
  // Índice compuesto: una vez por vehículo/conductor/día
  @@unique([truckId, driverId, inspectionDate])
  @@index([truckId])
  @@index([driverId])
  @@index([inspectionDate])
}

model MaintenanceItem {
  id          Int     @id @default(autoincrement())
  recordId    Int
  itemCode    String  // "estacionamiento", "frenoMano", etc.
  itemName    String
  category    String  // "systemLights", "systemBrakes", "systemTires", etc.
  exists      String  // "Si", "No"
  status      String  // "Bueno", "Regular", "Malo"
  notes       String?
  
  record      VehicleMaintenanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  
  @@index([recordId])
  @@unique([recordId, itemCode])
}

enum UserRole {
  EMPLOYEE
  DRIVER
  ADMIN
}

enum TripHistoryStatus {
  DRIVER_FILLING
  EMPLOYEE_SIGNED
  COMPLETED
}
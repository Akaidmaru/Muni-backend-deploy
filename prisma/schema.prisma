generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int               @id @default(autoincrement())
  email     String            @unique
  phone     String?           @unique
  name      String?
  password  String
  createdAt DateTime          @default(now())
  role      UserRole          @default(PATIENT)
  occupationId Int?
  occupation Occupation?      @relation(fields: [occupationId], references: [id])
  trucks    TruckAssignment[]
  tripHistories TripHistory[]
  isVerified Boolean          @default(false)
}

model Truck {
  id     Int               @id @default(autoincrement())
  plate  String            @unique
  model  String
  mileage Float            @default(0)
  routes Route[]
  users  TruckAssignment[]
  tripHistories TripHistory[]
}

model Destination {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tripHistories TripHistory[]
}

model TripHistory {
  id            Int         @id @default(autoincrement())
  date          DateTime
  startTime     String
  endTime       String
  startKm       Float
  endKm         Float
  truckId       Int
  destinationId Int
  employeeId    Int
  truck         Truck       @relation(fields: [truckId], references: [id])
  destination   Destination @relation(fields: [destinationId], references: [id])
  employee      User        @relation(fields: [employeeId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([date])
  @@index([truckId])
  @@index([destinationId])
  @@index([employeeId])
}

model RoutePoint {
  id        Int      @id @default(autoincrement())
  routeId   Int
  latitude  Float
  longitude Float
  order     Int
  route     Route    @relation(fields: [routeId], references: [id])
}
model TruckAssignment {
  userId  Int
  truckId Int
  truck   Truck @relation(fields: [truckId], references: [id])
  user    User  @relation(fields: [userId], references: [id])

  @@id([userId, truckId])
}

model Route {
  id      Int    @id @default(autoincrement())
  origin  String
  destination String
  truckId Int
  truck   Truck  @relation(fields: [truckId], references: [id])
  points  RoutePoint[]
}

model Occupation {
  id   Int    @id @default(autoincrement())
  name String
  users User[]
}

enum UserRole {
  PATIENT
  EMPLOYEE
  DRIVER
  ADMIN
}